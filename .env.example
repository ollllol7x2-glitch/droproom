# `openssl rand -base64 32` 또는 `npx auth secret`으로 생성하세요.
AUTH_SECRET=

# Google Cloud Console > APIs 및 서비스 > 사용자 인증 정보에서 발급합니다.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# /admin 접근을 허용할 Google 이메일입니다. 여러 개는 쉼표로 구분하세요.
AUTH_ADMIN_EMAILS=

# GitHub Pages처럼 브라우저에서 Supabase Auth를 사용할 때 필요한 공개 설정입니다.
# publishable key는 브라우저 노출을 전제로 하며 service_role/secret 키를 넣으면 안 됩니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 토스페이먼츠 개발자센터 > 결제위젯 연동 키 > 테스트 클라이언트 키입니다.
# 클라이언트 키는 브라우저 노출용 공개 키이며 시크릿 키는 절대 NEXT_PUBLIC_ 변수에 넣지 마세요.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# AI 쇼핑 도우미. 이 값들은 서버 전용이며 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# Groq Console > API Keys에서 발급한 키를 넣으면 기본 상담 모델이 활성화됩니다.
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# 선택 사항: 해당 키를 추가하면 상담창에서 Gemini 또는 ChatGPT(OpenAI)로도 전환할 수 있습니다.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
